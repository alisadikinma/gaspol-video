# Copy to .env in this plugin folder and fill in what you use. Never commit .env.
# Every variable here is OPTIONAL: a missing key degrades one capability loudly and
# never fails a skill. See reference/post-production/10-post-production-pipeline.md § 5.

# ElevenLabs — narration (tools/gen_vo.mjs), voice conversion (tools/voice_changer.mjs),
# sound effects (tools/gen_sfx.py), music bed generation (tools/gen_music.py), and voice
# cleanup (tools/clean_voice.py --method isolate).
# Missing: no generated speech, no SFX/music generation, no Voice Isolator cleanup.
# Platform-native audio still works; tools/clean_voice.py --method rnnoise needs no key.
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# AssemblyAI — timing for speech the video platform generated, used by tools/gen_subs.py,
# and the second-pass render verification in tools/verify_render.py (Check P6).
# Not needed when the narration came from ElevenLabs: those word timings come from the TTS
# response itself. Missing: cues for platform-spoken dialogue are listed as untimed, and P6
# reports SKIPPED (never PASS).
# https://assemblyai.com
ASSEMBLYAI_API_KEY=

# YouTube (tools/yt_stats.py) does NOT use an env var. Its OAuth client secret and token
# live under ${GASPOL_VIDEO_HOME:-~/.gaspol-video}/youtube/, outside this repo entirely —
# run `python3 tools/yt_stats.py auth` once to create them. Missing: packaging calibration
# has no real view/watch-time data; the CTR field always needs manual entry regardless.

# Voice ids, one per speaking cast slot. The repo names these variables and never holds
# their values — see reference/post-production/11-voice-cast-and-vo.md.
# The cast-profile.md VOICE: block points at the variable NAME, e.g. voice_env: ELEVENLABS_VOICE_C1.
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_C1=
ELEVENLABS_VOICE_C2=
ELEVENLABS_VOICE_C3=
