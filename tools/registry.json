  "routes": [
    {
      "task": "Download someone's video from a link",
      "use": "`python3 -m tools.vidkit ingest <url> <dir>`",
      "tools": [
        "tools/vidkit/ingest.py"
      ]
    },
    {
      "task": "Cut a video into scenes (clip + first/mid/last stills + scenes.json)",
      "use": "`python3 -m tools.vidkit scenes <video> <dir>`",
      "tools": [
        "tools/vidkit/ingest.py"
      ]
    },
    {
      "task": "Probe a clip (duration, fps, size, sample rate, channels)",
      "use": "`python3 -m tools.vidkit probe` / `vidkit.ff.probe`",
      "tools": [
        "tools/vidkit/ff.py"
      ]
    },
    {
      "task": "Check video length = audio length",
      "use": "`vidkit gate-av`; narration fits its cut: `check_vo_duration.py`",
      "tools": [
        "tools/check_vo_duration.py",
        "tools/vidkit/gates.py"
